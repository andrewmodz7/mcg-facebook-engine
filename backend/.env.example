# Postgres (Railway) — bare postgresql:// is fine; the app coerces it to asyncpg
DATABASE_URL=postgresql://user:password@host:port/dbname

# Apify (Facebook scraping)
APIFY_TOKEN=your-apify-token-here

# Anthropic Claude (scoring agent)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Dashboard HTTP Basic Auth credentials (two users in v1)
MARCUS_PASSWORD=facebook
ANDREW_PASSWORD=facebook

# CORS: the deployed frontend origin. Defaults to "*" for local dev.
FRONTEND_ORIGIN=*
