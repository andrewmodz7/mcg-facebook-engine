# Backend API base URL, used server-side by the Next.js rewrite proxy
# (see next.config.mjs). NOT prefixed with NEXT_PUBLIC — it's never exposed to
# the browser; the browser only ever hits relative /api/* paths on this origin.
# In production, point this at the backend service's Railway internal URL
# (e.g. http://backend.railway.internal:8000).
BACKEND_URL=http://localhost:8000
